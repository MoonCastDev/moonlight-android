<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mc_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MoonCast"
            android:textColor="@color/mc_dust"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ready to play"
            android:textColor="@color/mc_silver"
            android:textSize="52sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="-0.01"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="On your phone, open MoonCast and press Play on TV."
            android:textColor="@color/mc_dust"
            android:textSize="19sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/mc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="Waiting for your phone"
            android:textColor="@color/mc_moon"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:drawablePadding="12dp"
            android:gravity="center"/>
    </LinearLayout>
</RelativeLayout>
