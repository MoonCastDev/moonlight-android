<?xml version="1.0" encoding="utf-8"?>
<!-- MoonCast handheld: the SENDER. Never listens for other devices; it plays here or sends to a MoonCast TV.
     Until the handheld home is built, it opens Moonlight's PC list. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".PcView" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
